#--------------------------------------------------------------------
# PickAShift - STAGING  (https://reliefshifts.com/staging/)
#--------------------------------------------------------------------
# Generated into the bundle by deploy/build.php. Fill in the blanks BEFORE
# uploading, or fill them in on the server - but never commit real credentials
# to the repository.

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# The trailing slash and the /staging/ segment both matter. Get this wrong and
# every asset, form action and redirect points at the live site instead.

app.baseURL = 'https://reliefshifts.com/staging/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Use a SEPARATE database from the live site. Staging exists so that a mistake
# is cheap; pointing it at the production database removes that entirely - an
# approval test would e-mail real applicants and book real shifts.

database.default.hostname = localhost
database.default.database = pickashift_staging
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
# A distinct cookie name. Staging and live share the hostname, so one named
# ci_session would have logging into one silently log you out of the other.

session.cookieName = ci_session_staging
session.expiration = 7200
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# EMAIL  (SMTP - Mailgun; the domain's SPF/DKIM already authorise it)
#--------------------------------------------------------------------
# Credentials: Mailgun dashboard -> Sending -> Domain settings -> SMTP.
#
# CAUTION: with real credentials, staging sends real e-mail to real people.
# Either use a Mailgun sandbox domain here, or keep SMTPHost blank while you
# test screens - a blank host fails loudly in the admin panel and sends nothing.

email.protocol = smtp
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = 'donotreply@pickashift.ca'
email.fromName = 'PickAShift (staging)'

#--------------------------------------------------------------------
# NIGHTLY DATABASE BACKUP
#--------------------------------------------------------------------
# Left blank on purpose. Staging is a copy that exists to be broken, and a
# backup of it in somebody's inbox every morning is noise that trains people to
# ignore the one from the live site. Run it by hand when it is worth keeping:
#
#   php backup-database.php --no-mail
#
# Fill this in - comma-separated for more than one - to switch the mail on.

backup.to =
backup.keep = 7
backup.maxAttachMB = 20

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# 4 = info and worse. Useful while a change is being approved.

logger.threshold = 4
