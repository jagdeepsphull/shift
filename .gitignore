# Environment
env
.env

# Composer
/vendor/

# Node
/node_modules/

# CI writable
writable/cache/
writable/logs/
writable/session/
writable/debugbar/

# Nightly database backups. The whole database, in a folder inside the repo -
# the *.zip rule below catches the finished ones, this catches a .sql left
# behind by a run that stopped halfway.
writable/backups/

# Uploads (if generated by users). Everything in there except the rule that
# stops it being executed - deploy/build.php refuses to build without that file,
# so it has to be in the repository.
uploads/*
!uploads/.htaccess

# Backup folders
_backup*/

# Hand-made archives of the tree (deploy/build.php writes its own into
# deploy/build/, which is ignored there)
*.zip

# Scratch output from debugging the export tests
tests/e2e/row.txt

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# PHPUnit's cache and log output (phpunit.dist.xml writes both here)
/build/

# Playwright drops a run marker at the root when it is invoked from here;
# its real output is under tests/e2e/, which has its own ignore file
/test-results/
