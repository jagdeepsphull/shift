#--------------------------------------------------------------------
# PickAShift - PRODUCTION  (https://pickashift.ca/)
#--------------------------------------------------------------------
# Generated into the bundle by deploy/build.php. Fill in the blanks BEFORE
# uploading, or fill them in on the server - but never commit real credentials
# to the repository.
#
# This file must never be readable over the web. The .htaccess beside it refuses
# it, and index.php is the only thing in the folder that runs; check
# https://pickashift.ca/.env returns 403 once the site is up.

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# baseURL decides every link, form action and e-mail URL the site writes. Get
# it wrong and the site half-works in a way that is hard to see: forms post to
# the other domain and quietly lose the session.

app.baseURL = 'https://pickashift.ca/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

# There is deliberately no `app.allowedHostnames` here. Everything - including
# www.pickashift.ca - is redirected to the one host by .htaccess, so links,
# cookies and CSRF tokens all belong to the same origin.

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Use an account that owns this one database and nothing else. cPanel's MySQL
# user is not the same as the cPanel login and should not be reused anywhere.

database.default.hostname = localhost
database.default.database =
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SESSION AND COOKIES
#--------------------------------------------------------------------
# secure = true means the session cookie is never sent over plain http, so it
# cannot be read off an open network even if somebody reaches the site by an
# http link. It requires the site to be on https, which the line above forces.
#
# httponly keeps script from reading the cookie, which is what turns an XSS
# into a stolen session. samesite Lax stops another site's form posting as the
# signed-in user - the same attack the CSRF token catches, blocked twice.

session.cookieName = ci_session
session.expiration = 7200
session.matchIP = false
session.timeToUpdate = 300

# Left off, deliberately. CodeIgniter rotates the session id every five minutes
# on its own; with this on it deletes the previous file the instant it does, and
# any request already in flight against the old id - one of the ajax calls the
# shift form fires while you are typing - comes back signed out. The moment that
# actually matters for fixation is sign-in, and both login paths destroy the old
# session there explicitly (Front::login, Sadmin::login).
session.regenerateDestroy = false

cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

#--------------------------------------------------------------------
# EMAIL  (SMTP - Mailgun)
#--------------------------------------------------------------------
# Credentials: Mailgun dashboard -> Sending -> Domain settings -> SMTP.
#
# fromEmail stays on reliefshifts.com unless pickashift.ca has its own SPF,
# DKIM and DMARC records in DNS and its own Mailgun domain. Sending as
# @pickashift.ca before those exist means every booking confirmation is
# unauthenticated mail, and DMARC quarantines it - the site looks like it
# stopped sending e-mail, with nothing in the logs to say why.

email.protocol = smtp
email.SMTPHost = smtp.mailgun.org
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls
# The address the mail is *sent through* is above; the address it is *from* is
# below, and they are two different settings read by two different classes.
#
# `appsettings.` and not `email.`: every send site in the application calls
# setFrom() with `Config\AppSettings::$mailFromEmail`, so an `email.fromEmail`
# line here would be read into `Config\Email` and then never looked at. It used
# to be exactly that - a line that appeared to set the sender and did nothing.

appsettings.mailFromEmail = 'donotreply@pickashift.ca'
appsettings.mailFromName = 'PickAShift'

# Where a shift e-mail goes when the ticked side cannot be reached - a store
# with no manager account on it, or a recipient who turned that e-mail off in
# Manage Email. Never nobody.
appsettings.shiftEmailFallback = 'team@pickashift.ca'

#--------------------------------------------------------------------
# SCHEDULED JOBS
#--------------------------------------------------------------------
# The key on the end of the cron URLs. Without it those URLs return 404 - which
# also means the shift reminders stop going out, so fill this in and put the
# same value in the cron entry:
#
#   curl -s "https://pickashift.ca/cron/remind_shifts?key=PUT_THE_KEY_HERE"
#
# Generate one with:  php -r "echo bin2hex(random_bytes(16));"

cron.key =

#--------------------------------------------------------------------
# NIGHTLY DATABASE BACKUP
#--------------------------------------------------------------------
# Who `backup-database.php` e-mails the zipped backup to. More than one address,
# separated by commas - the first goes in To: and the rest are bcc, so one
# administrator's address is not shown to all the others every morning.
#
# The cron entry (cPanel > Cron Jobs, once a day, early):
#
#   /usr/local/bin/php /home/<user>/pickashift_app/backup-database.php --quiet
#
# --quiet prints nothing on a good run, so cron itself e-mails you only when the
# job fails to start. The backup message arrives either way, and says so when
# the backup could not be taken.

backup.to = 'pharmacyrelief@gmail.com'

# Days of backups kept on the server. The job deletes its own older zips, and
# only files it wrote itself.
backup.keep = 14

# The most it will attach. Gmail refuses a message over 25 MB and counts the
# encoding, which adds about a third; above this the mail says where the file is
# on the server rather than carrying it.
backup.maxAttachMB = 20

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# 3 = warnings and worse. Raise to 4 temporarily when chasing something.

logger.threshold = 3
